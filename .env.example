# CostSentinel configuration.
#
# Copy to .env and edit. .env is gitignored -- never commit real values.
# Every value below has a safe default: with no .env at all, CostSentinel runs
# fully offline against the mock provider and the fake LLM, with no credentials.

# ---------------------------------------------------------------------------
# Run mode
# ---------------------------------------------------------------------------
# mock = deterministic synthetic estate, no cloud calls (default)
# real = live Azure (read-only until Phase 10; requires the Azure settings below)
MODE=mock

# fake = deterministic structured output, no API key (default)
# azure_openai = primary real adapter      (Phase 3)
# gemini       = secondary fallback adapter (Phase 3)
LLM_BACKEND=fake

# Seed for the mock estate generator. The same seed always yields the same estate.
MOCK_SEED=1337

# ---------------------------------------------------------------------------
# Runtime state
# ---------------------------------------------------------------------------
# Directory for the LangGraph SQLite checkpoint database and generated artefacts.
STATE_DIR=.costsentinel

# debug | info | warning | error
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Rightsizing policy
# ---------------------------------------------------------------------------
# Headroom multiplier applied to observed peak CPU when picking a smaller SKU.
# 2.0 means "leave twice the observed peak". Raise it to be more conservative.
RIGHTSIZE_HEADROOM_FACTOR=2.0

# ---------------------------------------------------------------------------
# Azure (MODE=real only)
# ---------------------------------------------------------------------------
# Authentication is DefaultAzureCredential and nothing else: run `az login`, or
# use a managed or workload identity. There is deliberately no
# AZURE_CLIENT_SECRET setting -- CostSentinel never reads one, so it cannot leak
# one into a log, a trace or a commit. See SECURITY.md before a real run.
#
# The real path needs Reader and Cost Management Reader on the target
# subscriptions, and nothing more. It performs no write of any kind.
# AZURE_TENANT_ID=
#
# Required for MODE=real. There is no wildcard: a sweep reads the subscriptions
# you name here (or pass to --subscription) and no others.
# AZURE_SUBSCRIPTION_IDS=00000000-0000-0000-0000-000000000000
#
# Subscription tag naming the client it belongs to. Azure has no notion of
# CostSentinel's client boundary, so a managed-service provider marks it.
# AZURE_CLIENT_TAG=client

# ---------------------------------------------------------------------------
# Azure OpenAI (LLM_BACKEND=azure_openai)
# ---------------------------------------------------------------------------
# AZURE_OPENAI_API_KEY is optional and not the recommended path. Leave it unset
# and the adapter authenticates with DefaultAzureCredential -- the same
# credential MODE=real uses -- so there is no key to store, rotate or leak.
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_API_VERSION=2024-10-21
# AZURE_OPENAI_DEPLOYMENT=your-large-deployment
# AZURE_OPENAI_DEPLOYMENT_SMALL=your-small-deployment
# AZURE_OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Google Gemini (LLM_BACKEND=gemini)
# ---------------------------------------------------------------------------
# GEMINI_API_KEY=
# GEMINI_MODEL=
# GEMINI_MODEL_SMALL=

# ---------------------------------------------------------------------------
# Model call behaviour
# ---------------------------------------------------------------------------
# A real model occasionally returns something that does not validate; the second
# attempt is told exactly what was wrong.
# LLM_MAX_ATTEMPTS=2
# LLM_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------------------
# Model token prices, per million tokens
# ---------------------------------------------------------------------------
# Deliberately unset by default. A per-run model cost is a cost figure, and
# inventing a rate for whatever deployment you named would be a fabricated
# number dressed as a calculated one. Unset means the run reports its model cost
# as unknown, which is the truth. Fill these in from your own Azure OpenAI or
# Gemini pricing page to get a real figure.
# LLM_PRICE_SMALL_PROMPT=
# LLM_PRICE_SMALL_COMPLETION=
# LLM_PRICE_LARGE_PROMPT=
# LLM_PRICE_LARGE_COMPLETION=

# ---------------------------------------------------------------------------
# Memory (Phase 4) -- Postgres with pgvector. Omitted = stateless operation.
# ---------------------------------------------------------------------------
# DATABASE_URL=postgresql://costsentinel:costsentinel@localhost:5432/costsentinel

# ---------------------------------------------------------------------------
# Observability (Phase 3) -- omitted = tracing is a no-op.
# ---------------------------------------------------------------------------
# LANGFUSE_HOST=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
