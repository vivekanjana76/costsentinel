# CostSentinel configuration.
#
# Copy to .env and edit. .env is gitignored -- never commit real values.
# Every value below has a safe default: with no .env at all, CostSentinel runs
# fully offline against the mock provider and the fake LLM, with no credentials.

# ---------------------------------------------------------------------------
# Run mode
# ---------------------------------------------------------------------------
# mock = deterministic synthetic estate, no cloud calls (default)
# real = live Azure (read-only until Phase 10; requires the Azure settings below)
MODE=mock

# fake = deterministic structured output, no API key (default)
# azure_openai = primary real adapter      (Phase 3)
# gemini       = secondary fallback adapter (Phase 3)
LLM_BACKEND=fake

# Seed for the mock estate generator. The same seed always yields the same estate.
MOCK_SEED=1337

# ---------------------------------------------------------------------------
# Runtime state
# ---------------------------------------------------------------------------
# Directory for the LangGraph SQLite checkpoint database and generated artefacts.
STATE_DIR=.costsentinel

# debug | info | warning | error
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Rightsizing policy
# ---------------------------------------------------------------------------
# Headroom multiplier applied to observed peak CPU when picking a smaller SKU.
# 2.0 means "leave twice the observed peak". Raise it to be more conservative.
RIGHTSIZE_HEADROOM_FACTOR=2.0

# ---------------------------------------------------------------------------
# Exemption policy
# ---------------------------------------------------------------------------
# Tag conventions that mark a resource as idle, stale or oversized on purpose: a
# disaster-recovery standby, a snapshot under a retention requirement. Unset uses
# the rules shipped in src/costsentinel/guardrails/data/exemption_rules.json.
# Point this at your own file to add a client's conventions -- an overlay may add
# exemptions and can never remove a built-in one.
# EXEMPTION_RULES_PATH=./exemption_rules.json

# ---------------------------------------------------------------------------
# Azure (MODE=real only)
# ---------------------------------------------------------------------------
# Authentication is DefaultAzureCredential and nothing else: run `az login`, or
# use a managed or workload identity. There is deliberately no
# AZURE_CLIENT_SECRET setting -- CostSentinel never reads one, so it cannot leak
# one into a log, a trace or a commit. See SECURITY.md before a real run.
#
# The real path needs Reader and Cost Management Reader on the target
# subscriptions, and nothing more. It performs no write of any kind.
# AZURE_TENANT_ID=
#
# Required for MODE=real. There is no wildcard: a sweep reads the subscriptions
# you name here (or pass to --subscription) and no others.
# AZURE_SUBSCRIPTION_IDS=00000000-0000-0000-0000-000000000000
#
# Subscription tag naming the client it belongs to. Azure has no notion of
# CostSentinel's client boundary, so a managed-service provider marks it.
# AZURE_CLIENT_TAG=client

# ---------------------------------------------------------------------------
# Memory
# ---------------------------------------------------------------------------
# Episodic and semantic memory, so a sweep stops re-pitching advice a client
# already declined. The default needs nothing: a local SQLite file and a
# deterministic embedder, no service and no credential.
#
#   sqlite   (default) a local file under STATE_DIR
#   postgres durable, needs DATABASE_URL and `uv sync --extra memory`
#   off      no history at all; every consult step becomes a recorded no-op
# MEMORY_BACKEND=sqlite
# MEMORY_PATH=.costsentinel/memory.sqlite
# MEMORY_RECALL_LIMIT=500
#
# Required for MEMORY_BACKEND=postgres. docker-compose.yml sets this for you.
# DATABASE_URL=postgresql://costsentinel:costsentinel-dev-only@localhost:5432/costsentinel

# ---------------------------------------------------------------------------
# Embedding
# ---------------------------------------------------------------------------
# The fake embedder is deterministic and is what CI and the demo use. It is
# lexical, not semantic: it ranks by shared vocabulary, which is enough to
# exercise retrieval offline and is not a substitute for a real model.
#
# EMBEDDING_DIMENSIONS is also the pgvector column width, so it has to match
# whatever embedder is actually in use. The default is wide because hashed
# bag-of-words collides badly at small widths -- see memory/embedding.py.
# EMBEDDER_BACKEND=fake
# EMBEDDING_DIMENSIONS=4096
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# ---------------------------------------------------------------------------
# Azure OpenAI (LLM_BACKEND=azure_openai)
# ---------------------------------------------------------------------------
# AZURE_OPENAI_API_KEY is optional and not the recommended path. Leave it unset
# and the adapter authenticates with DefaultAzureCredential -- the same
# credential MODE=real uses -- so there is no key to store, rotate or leak.
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_API_VERSION=2024-10-21
# AZURE_OPENAI_DEPLOYMENT=your-large-deployment
# AZURE_OPENAI_DEPLOYMENT_SMALL=your-small-deployment
# AZURE_OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Google Gemini (LLM_BACKEND=gemini)
# ---------------------------------------------------------------------------
# GEMINI_API_KEY=
# GEMINI_MODEL=
# GEMINI_MODEL_SMALL=

# ---------------------------------------------------------------------------
# The operator dashboard
# ---------------------------------------------------------------------------
# Whether to serve the operator surface at /dashboard. Off by default: a page
# somebody can reach should be something an operator turned on.
#
# It renders the same ClientReport the Markdown report renders and computes no
# figure of its own. `costsentinel dashboard` writes the same pages to files if
# you would rather not serve anything.
# DASHBOARD_ENABLED=false

# Whether the dashboard may record an approval decision. Off by default, so the
# surface is a viewer unless somebody chose otherwise -- a deployment that wants
# eyes on the estate without hands on the queue gets that by default.
#
# Enabling it adds no new way to decide: a decision from the page goes through
# the same functions `costsentinel approvals decide` calls, and an approval still
# hands the action to a person. The POST is refused outright when this is off,
# because a hidden form field is not a permission check.
#
# With this on, a non-loopback BIND_HOST refuses to start unless an
# authenticator verifies approvers (Phase 10b). Until then every decision
# records its approver as self-asserted and unverified.
# DASHBOARD_CAN_DECIDE=false

# The address `costsentinel serve` binds, and the one the interlock above
# judges. Loopback by default; the container image sets 0.0.0.0.
# BIND_HOST=127.0.0.1

# ---------------------------------------------------------------------------
# The A2A surface
# ---------------------------------------------------------------------------
# Whether to serve the A2A endpoint. Off by default: a route another agent can
# reach should be something an operator turned on, not something that appeared.
# The Agent Card is served only when this is on.
#
# Every advertised skill is read-only. There is no skill that decides an
# approval and none that changes a resource.
# A2A_ENABLED=false
# A2A_URL=http://localhost:8000

# PEM P-256 private key the Agent Card is signed with: a JWS per A2A v1
# (ES256 over the RFC 8785 canonical card). The public key is published at
# /.well-known/agent-card-jwks.json. Unset in mock mode signs with a synthetic
# key derived from a committed, labelled seed, so CI verifies the signature on
# every run. Unset in real mode serves an *unsigned* card, because a signature
# anybody can forge invites a consumer to trust it. Never commit the key file.
# A2A_JWS_KEY_FILE=/run/secrets/costsentinel-card-key.pem

# Optional fallback for consumers of the Phase 10 card: a shared secret for a
# detached HMAC-SHA256, served in the X-CostSentinel-Card-HMAC header. This is
# NOT an A2A v1 signature and never appears in the card's `signatures`; it is
# symmetric, so anybody who can verify it can forge it. Unset by default.
# A2A_SIGNING_KEY=

# ---------------------------------------------------------------------------
# Model call behaviour
# ---------------------------------------------------------------------------
# A real model occasionally returns something that does not validate; the second
# attempt is told exactly what was wrong.
# LLM_MAX_ATTEMPTS=2
# LLM_TIMEOUT_SECONDS=60

# Retry on a second backend when the primary fails, is rate limited, or returns
# something that will not validate. Must differ from LLM_BACKEND: retrying the
# same backend is a retry, not a fallback, and that configuration is refused.
# Unset means no fallback, which is already safe -- a model failure costs the
# prose and nothing else.
# LLM_FALLBACK_BACKEND=gemini

# Ceiling on model tokens per sweep. Unset means uncapped; the right figure
# depends on the estate, so there is no sensible default to guess.
#
# Reaching it stops new model calls and nothing else. Every finding, figure,
# action class, rank and approval-queue entry is deterministic arithmetic the
# model never touched, so a capped run produces a complete report whose narrative
# is replaced by a stated reason. See SECURITY.md section 5 for the full table of
# what degrades.
# LLM_TOKEN_BUDGET=200000

# ---------------------------------------------------------------------------
# Model token prices, per million tokens
# ---------------------------------------------------------------------------
# Deliberately unset by default. A per-run model cost is a cost figure, and
# inventing a rate for whatever deployment you named would be a fabricated
# number dressed as a calculated one. Unset means the run reports its model cost
# as unknown, which is the truth. Fill these in from your own Azure OpenAI or
# Gemini pricing page to get a real figure.
# LLM_PRICE_SMALL_PROMPT=
# LLM_PRICE_SMALL_COMPLETION=
# LLM_PRICE_LARGE_PROMPT=
# LLM_PRICE_LARGE_COMPLETION=

# ---------------------------------------------------------------------------
# Memory (Phase 4) -- Postgres with pgvector. Omitted = stateless operation.
# ---------------------------------------------------------------------------
# DATABASE_URL=postgresql://costsentinel:costsentinel@localhost:5432/costsentinel

# ---------------------------------------------------------------------------
# Observability (Phase 3) -- omitted = tracing is a no-op.
# ---------------------------------------------------------------------------
# LANGFUSE_HOST=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
