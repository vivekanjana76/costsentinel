# Secrets -- never commit. See .env.example for the shape.
.env
.env.*
!.env.example
*.pem
*.key

# Python
__pycache__/
*.py[cod]
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# Environments
.venv/
venv/

# Rendered reports. The one copy that belongs in the repository is the committed
# sample under docs/, which is synthetic and labelled as such; everything else is an
# artefact of a run and some of it describes a real estate.
tmp/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyright/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Runtime state: LangGraph checkpoints, generated reports, scorecards
.costsentinel/
var/
out/
*.sqlite
*.sqlite3
*.db

# Real-run output. A live scan writes here by default (see cli.py and SECURITY.md).
# This is real client cost data: never commit it. scripts/check_no_real_data.py is
# the second layer, because `git add -f` gets past a gitignore and git history is
# permanent.
var/real-runs/
*.real.json
*.real.md

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
